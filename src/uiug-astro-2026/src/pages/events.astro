---
import Layout from '../layouts/Layout.astro';
import FullEventListPage from '../components/react/FullEventListPage';
import { getAllEvents } from '../lib/event-mapper';

// Fetch all events from CMS
let events = [];
try {
  events = await getAllEvents();
} catch {
  events = [];
}
---

<Layout title="Events | UIUG">
  <FullEventListPage events={events} client:load />
</Layout>
