---
import Layout from '../layouts/Layout.astro';
import AppShell from '../components/react/AppShell';
import Hero from '../components/astro/Hero.astro';
import Marquee from '../components/astro/Marquee.astro';
import Features from '../components/astro/Features.astro';
import LatestEvents from '../components/astro/LatestEvents.astro';
import Showcase from '../components/astro/Showcase.astro';
import MarqueeReverse from '../components/astro/MarqueeReverse.astro';
import Speakers from '../components/react/Speakers';
import Countdown from '../components/react/Countdown';
import Gallery from '../components/react/Gallery';
import Appreciation from '../components/react/Appreciation';
import Contact from '../components/react/Contact';
import FAQ from '../components/react/FAQ';
import JoinUs from '../components/react/JoinUs';
import Footer from '../components/react/Footer';
import Sponsors from '../components/react/Sponsors';
import { getSiteSettings, getHomeContent, getMainContentBlocks, getHeroBlock } from '../api/umbraco';
import { getComponentIdentifier } from '../lib/component-order';
import { mapHeroProps } from '../lib/hero-mapper';
import { mapFeaturesProps } from '../lib/features-mapper';
import { mapMarqueeProps } from '../lib/marquee-mapper';
import { mapMarqueeReverseProps } from '../lib/marquee-reverse-mapper';
import { mapLatestEventsProps } from '../lib/latest-events-mapper';
import { mapShowcaseProps } from '../lib/showcase-mapper';
import { mapCountdownProps } from '../lib/countdown-mapper';
import { mapSpeakersProps } from '../lib/speakers-mapper';
import { mapFAQProps } from '../lib/faq-mapper';
import { mapContactProps } from '../lib/contact-mapper';
import { mapSponsorsProps } from '../lib/sponsors-mapper';
import { mapGalleryProps } from '../lib/gallery-mapper';
import type { components } from '../api/types';

// Fetch site settings from CMS server-side
const layoutData = await getSiteSettings();

// Fetch all blocks from Umbraco and Hero props
let blocks: ReturnType<typeof getMainContentBlocks> = [];
let heroProps = null;
const latestEventsPropsMap = new Map<number, Awaited<ReturnType<typeof mapLatestEventsProps>>>();
const showcasePropsMap = new Map<number, Awaited<ReturnType<typeof mapShowcaseProps>>>();
const speakersPropsMap = new Map<number, Awaited<ReturnType<typeof mapSpeakersProps>>>();
const faqPropsMap = new Map<number, Awaited<ReturnType<typeof mapFAQProps>>>();
const sponsorsPropsMap = new Map<number, Awaited<ReturnType<typeof mapSponsorsProps>>>();
const galleryPropsMap = new Map<number, Awaited<ReturnType<typeof mapGalleryProps>>>();
try {
  const homeContent = await getHomeContent();
  blocks = getMainContentBlocks(homeContent);
  
  // Get Hero props for dynamic Hero component
  const heroBlock = getHeroBlock(homeContent);
  if (heroBlock) {
    heroProps = mapHeroProps(heroBlock);
  }
  
  // Pre-fetch all async component props (LatestEvents, Showcase, Speakers, FAQ, and Sponsors)
  const asyncPropsPromises = blocks.map(async (block, index) => {
    const contentType = block.content?.contentType;
    const componentId = getComponentIdentifier(contentType);
    if (componentId === 'latestEvents') {
      const latestEventsBlock = block.content as components['schemas']['LatestEventsElementModel'];
      try {
        return { index, type: 'latestEvents', props: await mapLatestEventsProps(latestEventsBlock) };
      } catch (error) {
        console.error(`Error mapping LatestEvents props at index ${index}:`, error);
        return { index, type: 'latestEvents', props: {} };
      }
    }
    if (componentId === 'showcase') {
      const showcaseBlock = block.content as components['schemas']['ProjectsShowcaseElementModel'];
      try {
        const props = await mapShowcaseProps(showcaseBlock);
        return { index, type: 'showcase', props };
      } catch (error) {
        console.error(`Error mapping Showcase props at index ${index}:`, error);
        return { index, type: 'showcase', props: {} };
      }
    }
    if (componentId === 'speakers') {
      const speakersBlock = block.content as components['schemas']['SpeakersElementElementModel'];
      try {
        const props = await mapSpeakersProps(speakersBlock);
        return { index, type: 'speakers', props };
      } catch (error) {
        console.error(`Error mapping Speakers props at index ${index}:`, error);
        return { index, type: 'speakers', props: {} };
      }
    }
    if (componentId === 'faq') {
      const faqBlock = block.content as components['schemas']['FaqElementModel'];
      try {
        const props = await mapFAQProps(faqBlock);
        return { index, type: 'faq', props };
      } catch (error) {
        console.error(`Error mapping FAQ props at index ${index}:`, error);
        return { index, type: 'faq', props: {} };
      }
    }
    if (componentId === 'sponsors') {
      const sponsorsBlock = block.content as components['schemas']['SponsorsElementModel'];
      console.log(`\n🚀 CALLING mapSponsorsProps at index ${index}`);
      console.log('Sponsors block:', sponsorsBlock);
      try {
        const props = await mapSponsorsProps(sponsorsBlock);
        console.log('✅ Sponsors props returned:', props);
        return { index, type: 'sponsors', props };
      } catch (error) {
        console.error(`❌ Error mapping Sponsors props at index ${index}:`, error);
        return { index, type: 'sponsors', props: {} };
      }
    }
    if (componentId === 'gallery') {
      const galleryBlock = block.content as components['schemas']['GalleryElementModel'];
      try {
        const props = await mapGalleryProps(galleryBlock);
        return { index, type: 'gallery', props };
      } catch (error) {
        console.error(`Error mapping Gallery props at index ${index}:`, error);
        return { index, type: 'gallery', props: {} };
      }
    }
    return null;
  });
  
  const asyncPropsResults = await Promise.all(asyncPropsPromises);
  asyncPropsResults.forEach((result) => {
    if (result) {
      if (result.type === 'latestEvents') {
        latestEventsPropsMap.set(result.index, result.props);
      } else if (result.type === 'showcase') {
        showcasePropsMap.set(result.index, result.props);
      } else if (result.type === 'speakers') {
        speakersPropsMap.set(result.index, result.props);
      } else if (result.type === 'faq') {
        faqPropsMap.set(result.index, result.props);
      } else if (result.type === 'sponsors') {
        sponsorsPropsMap.set(result.index, result.props);
      } else if (result.type === 'gallery') {
        galleryPropsMap.set(result.index, result.props);
      }
    }
  });
} catch (error) {
  console.error('Error fetching Home content blocks:', error);
  // Continue with empty blocks array - components will be skipped
}

// Preload Spline 404 scene for faster loading when users hit 404 page
const splineSceneUrl = 'https://prod.spline.design/qThvraxcn3H54Udn/scene.splinecode';
---

<Layout title={layoutData.siteName ? `${layoutData.siteName} - Umbraco India User Group` : 'UIUG - Umbraco India User Group'}>
  {/* Preload Spline 404 scene - cache it early for faster 404 page loads */}
  <link rel="preload" href={splineSceneUrl} as="fetch" crossorigin="anonymous" />
  <link rel="dns-prefetch" href="https://prod.spline.design" />
  <link rel="preconnect" href="https://prod.spline.design" crossorigin />
  
  <AppShell 
    client:only="react"
    logo={layoutData.logo}
    navItems={layoutData.navItems}
    ctaItem={layoutData.ctaItem}
  >
    {/* Dynamically render components based on Umbraco block list order */}
    {blocks.map((block, index) => {
      const contentType = block.content?.contentType;
      const componentId = getComponentIdentifier(contentType);
      
      // Skip unmapped component types
      if (!componentId) {
        if (import.meta.env.DEV) {
          console.warn(`Unknown block content type: ${contentType}`);
        }
        return null;
      }
      
      // Render component based on identifier
      if (componentId === 'hero') {
        // Always render Hero - it has fallback defaults if heroProps is null
        return heroProps ? <Hero hero={heroProps} /> : <Hero />;
      }
      if (componentId === 'marquee') {
        const marqueeBlock = block.content as components['schemas']['MarqueeElementModel'];
        const marqueeProps = mapMarqueeProps(marqueeBlock);
        return <Marquee marquee={marqueeProps} />;
      }
      if (componentId === 'marqueeReverse') {
        const marqueeReverseBlock = block.content as components['schemas']['MarqueeReverseElementModel'];
        const marqueeReverseProps = mapMarqueeReverseProps(marqueeReverseBlock);
        return <MarqueeReverse marqueeReverse={marqueeReverseProps} />;
      }
      if (componentId === 'features') {
        const featuresBlock = block.content as components['schemas']['FeaturesElementModel'];
        const featuresProps = mapFeaturesProps(featuresBlock);
        return <Features features={featuresProps} />;
      }
      if (componentId === 'countdown') {
        const countdownBlock = block.content as components['schemas']['CountdownElementModel'];
        const countdownProps = mapCountdownProps(countdownBlock);
        return <Countdown countdown={countdownProps} client:load />;
      }
      if (componentId === 'latestEvents') {
        const latestEventsProps = latestEventsPropsMap.get(index);
        return <LatestEvents latestEvents={latestEventsProps} />;
      }
      if (componentId === 'speakers') {
        const speakersProps = speakersPropsMap.get(index);
        return <Speakers speakers={speakersProps} client:load />;
      }
      if (componentId === 'showcase') {
        const showcaseProps = showcasePropsMap.get(index);
        return <Showcase showcase={showcaseProps} />;
      }
      if (componentId === 'sponsors') {
        const sponsorsProps = sponsorsPropsMap.get(index);
        return <Sponsors sponsors={sponsorsProps} client:visible />;
      }
      if (componentId === 'gallery') {
        const galleryProps = galleryPropsMap.get(index);
        return <Gallery gallery={galleryProps} client:load />;
      }
      if (componentId === 'appreciation') {
        return <Appreciation client:load />;
      }
      if (componentId === 'faq') {
        const faqProps = faqPropsMap.get(index);
        return <FAQ faq={faqProps} client:load />;
      }
      if (componentId === 'contact') {
        const contactBlock = block.content as components['schemas']['ContactUsElementModel'];
        const contactProps = mapContactProps(contactBlock);
        return <Contact contact={contactProps} client:load />;
      }
      
      return null;
    })}
    
    {/* Footer remains separate - uses siteSettings */}
    <Footer 
      client:load 
      footer={layoutData.footer}
      social={layoutData.social}
    />
  </AppShell>
</Layout>

