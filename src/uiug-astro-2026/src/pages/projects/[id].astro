---
import Layout from '../../layouts/Layout.astro';
import ProjectDetailPage from '../../components/react/ProjectDetailPage';
import { getAllProjects, getProjectById } from '../../lib/project-mapper';
import type { Project } from '../../data/projects';

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((project) => ({ params: { id: project.id } }));
}

const { id } = Astro.params;
const project: Project | null | undefined = id ? await getProjectById(id) : undefined;
---

{project ? (
  <Layout title={`${project.title} | Projects | UIUG`} seo={project.seo}>
    <ProjectDetailPage project={project} client:visible />
  </Layout>
) : (
  <Layout title="Not Found | UIUG">
    <div class="min-h-screen flex items-center justify-center bg-white dark:bg-black">
      <div class="text-center">
        <h1 class="font-display text-4xl uppercase text-black dark:text-white mb-4">PROJECT_NOT_FOUND</h1>
        <a href="/projects" class="font-mono font-bold text-primary hover:underline">← BACK_TO_PROJECTS</a>
      </div>
    </div>
  </Layout>
)}
