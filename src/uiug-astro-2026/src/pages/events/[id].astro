---
import Layout from '../../layouts/Layout.astro';
import EventDetailPage from '../../components/react/EventDetailPage';
import { getAllEvents, getEventById } from '../../lib/event-mapper';

export async function getStaticPaths() {
  const events = await getAllEvents();
  
  if (import.meta.env.DEV) {
    console.log(`[Events] Found ${events.length} events for static paths`);
    events.forEach(event => {
      console.log(`[Events] Generating path for event: /events/${event.id} (${event.title})`);
    });
  }
  
  return events.map((event) => ({ params: { id: event.id } }));
}

const { id } = Astro.params;

if (import.meta.env.DEV) {
  console.log(`[Event Detail] Looking for event with ID: ${id}`);
}

const event = id ? await getEventById(id) : undefined;

if (import.meta.env.DEV) {
  if (event) {
    console.log(`[Event Detail] Found event: ${event.title} (ID: ${event.id})`);
  } else {
    console.warn(`[Event Detail] Event not found for ID: ${id}`);
  }
}
---

{event ? (
  <Layout title={`${event.title} | Events | UIUG`}>
    <EventDetailPage event={event} client:load />
  </Layout>
) : (
  <Layout title="Not Found | UIUG">
    <div class="min-h-screen flex items-center justify-center bg-white dark:bg-black">
      <div class="text-center">
        <h1 class="font-display text-4xl uppercase text-black dark:text-white mb-4">EVENT_NOT_FOUND</h1>
        <a href="/events" class="font-mono font-bold text-primary hover:underline">← BACK_TO_EVENTS</a>
      </div>
    </div>
  </Layout>
)}
