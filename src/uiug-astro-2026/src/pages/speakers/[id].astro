---
import Layout from '../../layouts/Layout.astro';
import SpeakerDetailPage from '../../components/react/SpeakerDetailPage';
import { getAllSpeakers, getSpeakerById } from '../../lib/speaker-mapper';
import { fetchGithubActivity } from '../../lib/github-activity';
import type { Speaker } from '../../data/speakers';
import type { GithubActivity } from '../../lib/github-activity';

export async function getStaticPaths() {
  const speakers = await getAllSpeakers();
  return speakers.map((speaker) => ({ params: { id: speaker.id } }));
}

const { id } = Astro.params;
const speaker: Speaker | null | undefined = id ? await getSpeakerById(id) : undefined;

let githubActivity: GithubActivity | null = null;
if (speaker?.githubUrl) {
  githubActivity = await fetchGithubActivity(speaker.githubUrl);
}
---

{speaker ? (
  <Layout title={`${speaker.name} | Speakers | UIUG`} seo={speaker.seo}>
    <SpeakerDetailPage speaker={speaker} githubActivity={githubActivity} client:visible />
  </Layout>
) : (
  <Layout title="Not Found | UIUG">
    <div class="min-h-screen flex items-center justify-center bg-white dark:bg-black">
      <div class="text-center">
        <h1 class="font-display text-4xl uppercase text-black dark:text-white mb-4">SPEAKER_NOT_FOUND</h1>
        <a href="/speakers" class="font-mono font-bold text-primary hover:underline">← BACK_TO_SPEAKERS</a>
      </div>
    </div>
  </Layout>
)}
