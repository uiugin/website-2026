---
import '../styles/global.css';
import type { PageSeo } from '../types/seo';

interface Props {
  title?: string;
  seo?: PageSeo | null;
}

const { title = "UIUG - Umbraco India User Group", seo } = Astro.props;

const displayTitle = (seo?.title != null && seo.title !== '') ? seo.title : title;
const site = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;

function absoluteUrl(url: string | null | undefined): string {
  if (!url) return '';
  if (url.startsWith('http://') || url.startsWith('https://')) return url;
  return `${site}${url.startsWith('/') ? '' : '/'}${url}`;
}

const canonical = seo?.canonicalUrl != null && seo.canonicalUrl !== '' ? absoluteUrl(seo.canonicalUrl) : undefined;
const ogImage = seo?.ogImage != null && seo.ogImage !== '' ? absoluteUrl(seo.ogImage) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{displayTitle}</title>
    {seo?.description != null && seo.description !== '' && (
      <meta name="description" content={seo.description} />
    )}
    {seo?.keywords != null && seo.keywords !== '' && (
      <meta name="keywords" content={seo.keywords} />
    )}
    {seo?.noindex === true && (
      <meta name="robots" content="noindex" />
    )}
    {canonical && <link rel="canonical" href={canonical} />}
    {(seo?.ogTitle ?? seo?.title ?? displayTitle) && (
      <meta property="og:title" content={seo?.ogTitle ?? seo?.title ?? displayTitle} />
    )}
    {(seo?.ogDescription ?? seo?.description) != null && (seo?.ogDescription ?? seo?.description) !== '' && (
      <meta property="og:description" content={seo?.ogDescription ?? seo?.description ?? ''} />
    )}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- font-display=swap to avoid blocking render; Space Mono + Archivo Black are used in theme -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Archivo+Black&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Archivo+Black&display=swap" media="print" onload="this.setAttribute('media','all')" />
    <!-- Google Sans Text: not referenced in codebase; remove if unused elsewhere -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Google+Sans+Text&display=swap" media="print" onload="this.setAttribute('media','all')" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Archivo+Black&display=swap" />
      <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Google+Sans+Text&display=swap" />
    </noscript>
    <script is:inline>
      // Apply theme and palette immediately before React hydrates to prevent flash
      (function() {
        const root = document.documentElement;
        
        // Apply theme
        const savedTheme = localStorage.getItem('theme');
        const isDark = savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          root.classList.add('dark');
        } else {
          root.classList.remove('dark');
        }
        
        // Apply palette colors
        const savedPaletteId = localStorage.getItem('paletteId') || 'default';
        const savedCustomColors = localStorage.getItem('customColors');
        
        let colors;
        if (savedPaletteId === 'custom' && savedCustomColors) {
          colors = JSON.parse(savedCustomColors);
        } else {
          const presets = {
            default: { primary: '#FF0000', accent: '#FFFF00' },
            cyber: { primary: '#00FF41', accent: '#FF00FF' },
            ocean: { primary: '#0044FF', accent: '#00FFFF' },
            toxic: { primary: '#BD00FF', accent: '#CCFF00' }
          };
          colors = presets[savedPaletteId] || presets.default;
        }
        
        if (colors) {
          root.style.setProperty('--color-primary', colors.primary);
          root.style.setProperty('--color-accent', colors.accent);
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

