---
import { Reveal, Slide } from '../react/Reveal';
import { Layers, Cpu, ArrowUpRight, Database } from 'lucide-react';
import type { ShowcaseProps } from '../../lib/showcase-mapper';
import { appendImageCrop } from '../../api/umbraco';

interface Props {
  showcase?: ShowcaseProps;
}

const { showcase } = Astro.props;

// Use projects from props - no fallback defaults, component should be fully dynamic
const projects = showcase?.projects || [];

// Use title from props if available, otherwise use default
const sectionTitle = showcase?.title || 'COMMUNITY_BUILDS';

// Submission section content
const submissionHeading = showcase?.submissionHeading || 'BUILT_SOMETHING_EPIC?';
const submissionDescription = showcase?.submissionDescription || 'SUBMIT YOUR UMBRACO PROJECT TO THE INDIA SHOWCASE. WE FEATURE THE CODE THAT PUSHES BOUNDARIES.';
const submissionButtonUrl = showcase?.submissionButtonUrl;
const moreButtonUrl = showcase?.moreButtonUrl;
---

<section class="px-4 md:px-10 mb-20 w-full relative z-10" id="showcase_03">
   {/* Header */}
   <Reveal width="100%" client:visible>
    <div class="flex items-center gap-4 mb-10 md:mb-16 border-b-4 border-black dark:border-white pb-4">
        <div class="h-4 w-4 md:h-8 md:w-8 inline-flex items-center justify-center border-2 border-black dark:border-white bg-black dark:bg-white shrink-0 [&_svg]:block [&_svg]:shrink-0">
        <Layers className="w-3 h-3 md:w-5 md:h-5 text-white dark:text-black" />
        </div>
        <h2 class="text-4xl md:text-6xl font-display font-black uppercase text-black dark:text-white tracking-tighter leading-none">
            {sectionTitle.toUpperCase()}
        </h2>
        <span class="font-mono text-xs font-bold text-gray-500 mb-2 ml-auto hidden md:block">
            // DEPLOYED_TO_PROD
        </span>
    </div>
  </Reveal>

  {projects.length > 0 ? (
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      {projects.map((project, index) => (
        <Slide 
            direction={index % 2 === 0 ? "left" : "right"} 
            width="100%" 
            className={`${index === 2 ? 'lg:col-span-2' : ''}`}
            client:visible
        >
            <div 
                class={`group bg-white dark:bg-black border-4 border-black dark:border-white p-4 shadow-brutal-black dark:shadow-brutal-white hover:shadow-brutal-red transition-all duration-300 flex flex-col h-full ${index === 2 ? 'lg:flex-row lg:items-stretch' : ''}`}
            >
                {/* Image Section */}
                <div class={`relative overflow-hidden border-4 border-black dark:border-white bg-gray-200 mb-6 lg:mb-0 ${index === 2 ? 'w-full lg:w-1/2 lg:mr-8 lg:mb-0 aspect-video lg:aspect-auto' : 'w-full aspect-video'}`}>
                    <img 
                        src={appendImageCrop(project.image, 640, 360)} 
                        alt={project.title} 
                        width={640}
                        height={360}
                        loading="lazy"
                        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-100 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-300"></div>
                    
                    {/* Overlay Tag */}
                    <div class="absolute top-4 left-4 bg-primary text-black px-3 py-1 font-bold text-xs border-2 border-black dark:border-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                        BUILD_{project.year}
                    </div>
                </div>

                {/* Content Section */}
                <div class={`flex flex-col flex-grow ${index === 2 ? 'lg:w-1/2 lg:py-4' : ''}`}>
                    <div class="flex items-center gap-2 mb-2 mt-2 font-mono text-xs font-bold text-gray-500">
                        <Layers className="w-4 h-4" />
                        <span>CLIENT: {project.client}</span>
                    </div>

                    <h3 class="text-3xl font-display font-black uppercase text-black dark:text-white leading-[0.9] mb-4 group-hover:text-primary transition-colors">
                        {project.title}
                    </h3>

                    <p class="font-mono text-sm font-bold text-black dark:text-white mb-6 leading-relaxed opacity-80">
                        {project.description}
                    </p>

                    <div class="mt-auto">
                        <div class="flex flex-wrap gap-2 mb-6">
                            {project.stack.map(tech => (
                                <span class="px-2 py-1 border-2 border-black dark:border-white text-[10px] font-bold uppercase bg-gray-100 dark:bg-gray-900 text-black dark:text-white flex items-center gap-1">
                                    <Cpu className="w-3 h-3" /> {tech}
                                </span>
                            ))}
                        </div>

                        {project.url && project.url !== '#' ? (
                          <a href={project.url} class="w-full bg-black text-white dark:bg-white dark:text-black py-4 font-display text-lg uppercase border-4 border-transparent hover:bg-accent-yellow hover:text-black hover:border-black dark:hover:border-white transition-all flex items-center justify-between px-6 group/btn">
                            VIEW_CASE_STUDY
                            <ArrowUpRight className="w-6 h-6 group-hover/btn:translate-x-1 group-hover/btn:-translate-y-1 transition-transform" />
                          </a>
                        ) : (
                          <button class="w-full bg-black text-white dark:bg-white dark:text-black py-4 font-display text-lg uppercase border-4 border-transparent hover:bg-accent-yellow hover:text-black hover:border-black dark:hover:border-white transition-all flex items-center justify-between px-6 group/btn">
                            VIEW_CASE_STUDY
                            <ArrowUpRight className="w-6 h-6 group-hover/btn:translate-x-1 group-hover/btn:-translate-y-1 transition-transform" />
                          </button>
                        )}
                    </div>
                </div>
            </div>
        </Slide>
      ))}
    </div>
  ) : (
    <div class="text-center py-12 border-4 border-dashed border-black dark:border-white">
      <p class="font-mono text-lg font-bold text-black dark:text-white">NO_PROJECTS_LOADED</p>
      {import.meta.env.DEV && (
        <p class="font-mono text-sm text-gray-500 mt-2">Check console for debug logs</p>
      )}
    </div>
  )}

  {/* Full Database CTA */}
  {moreButtonUrl && moreButtonUrl !== '#' ? (
    <div class="mt-12 flex justify-center">
      <Reveal client:visible>
        <a href={moreButtonUrl} class="group bg-transparent border-4 border-black dark:border-white text-black dark:text-white px-8 py-3 font-display text-xl uppercase hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors shadow-brutal-black dark:shadow-brutal-white active:translate-x-1 active:translate-y-1 active:shadow-none">
          VIEW_FULL_DATABASE
        </a>
      </Reveal>
    </div>
  ) : (
    <div class="mt-12 flex justify-center">
      <Reveal client:visible>
        <button class="group bg-transparent border-4 border-black dark:border-white text-black dark:text-white px-8 py-3 font-display text-xl uppercase hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors shadow-brutal-black dark:shadow-brutal-white active:translate-x-1 active:translate-y-1 active:shadow-none">
          VIEW_FULL_DATABASE
        </button>
      </Reveal>
    </div>
  )}

  {/* Submission CTA */}
  <Reveal width="100%" delay={0.2} client:visible>
    <div class="mt-12 bg-primary border-4 border-black dark:border-white p-8 md:p-12 text-center shadow-brutal-black dark:shadow-brutal-white relative overflow-hidden group cursor-pointer">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/diagmonds-light.png')] opacity-20"></div>
        <div class="relative z-10 flex flex-col items-center">
            <Database className="w-12 h-12 mb-4 text-black animate-bounce" />
            <h3 class="text-xl sm:text-2xl md:text-5xl font-display font-black uppercase text-black mb-4">
                {submissionHeading.toUpperCase()}
            </h3>
            <p class="font-mono font-bold text-black max-w-2xl mb-8">
                {submissionDescription.toUpperCase()}
            </p>
            {submissionButtonUrl && submissionButtonUrl !== '#' ? (
              <a href={submissionButtonUrl} class="bg-black text-white px-8 py-3 font-bold uppercase text-lg border-2 border-transparent hover:bg-white hover:text-black hover:border-black transition-colors shadow-[4px_4px_0px_0px_rgba(255,255,255,0.5)] hover:shadow-none translate-y-0 hover:translate-y-1">
                SUBMIT_PROJECT_URL
              </a>
            ) : (
              <button class="bg-black text-white px-8 py-3 font-bold uppercase text-lg border-2 border-transparent hover:bg-white hover:text-black hover:border-black transition-colors shadow-[4px_4px_0px_0px_rgba(255,255,255,0.5)] hover:shadow-none translate-y-0 hover:translate-y-1">
                SUBMIT_PROJECT_URL
              </button>
            )}
        </div>
    </div>
  </Reveal>
</section>

