---
import Button from '../react/Button';
import { Reveal, Slide } from '../react/Reveal';
import { Zap, Calendar, Clock, ArrowRight } from 'lucide-react';
import type { HeroProps } from '../../lib/hero-mapper';

interface Props {
  hero?: HeroProps;
}

const { hero } = Astro.props;

// Extract props with fallbacks
const status = hero?.status || 'INDIA_OPERATIONAL';
const title = hero?.title || 'RAW\nUMBRACO\nPOWER.';
const caption = hero?.caption || "We don't just build sites. We architect digital dominance. Join the elite Umbraco core in India.";

// Use fallback buttons if buttons are undefined or empty array
// Always ensure we have at least the default buttons
const defaultButtons = [
  { text: 'Initiate Sequence', url: '#', variant: 'primary' as const },
  { text: 'View_Members', url: '#', variant: 'outline' as const }
];

// Ensure buttons always has a value - use hero buttons if available, otherwise defaults
let buttons: Array<{ text: string; url: string; variant: 'primary' | 'outline' }> = defaultButtons;
if (hero?.buttons && Array.isArray(hero.buttons) && hero.buttons.length > 0) {
  buttons = hero.buttons.map((b) => ({ text: b.text, url: b.url, variant: (b.variant ?? 'primary') as 'primary' | 'outline' }));
}

// Safety check - ensure buttons is never empty
if (!buttons || !Array.isArray(buttons) || buttons.length === 0) {
  buttons = defaultButtons;
}

const slideImage = hero?.slideImage || 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=1200&auto=format&fit=crop';
const slideLabel = hero?.slideLabel || 'RUNTIME: .NET_CORE';
const slideLabelTwo = hero?.slideLabelTwo || 'CACHE: REFRESHED';

// Upcoming session: show "Yet to be announced" when values are null or empty
const upcomingSessionTitle = hero?.upcomingSessionTitle?.trim() || 'Yet to be announced';
const upcomingSessionDate = hero?.upcomingSessionDate?.trim() || 'Yet to be announced';
const upcomingSessionTime = hero?.upcomingSessionTime?.trim() || 'Yet to be announced';

// Parse title - handle HTML content from Umbraco
// If title contains HTML, we'll render it with set:html, otherwise split by newlines
const titleHasHtml = title.includes('<') && title.includes('>');
const titleLines = titleHasHtml ? null : (title.includes('\n') ? title.split('\n') : [title]);
---

<section class="px-4 md:px-10 pb-20 w-full relative overflow-hidden">
  <div class="flex flex-col lg:grid lg:grid-cols-12 gap-10 lg:gap-0 relative items-center">
    {/* Left Content */}
    <div class="lg:col-span-7 xl:col-span-8 z-20 relative pt-10 lg:pt-20">
      <Reveal client:visible>
        <div class="inline-block px-4 py-1 mb-6 font-bold bg-black text-white dark:bg-white dark:text-black shadow-brutal-red dark:shadow-brutal-white border-2 border-transparent">
            {status.startsWith('STATUS:') ? status : `STATUS: [${status}]`}
        </div>
      </Reveal>
      
      <Reveal delay={0.1} client:visible>
        <h1 
          class="text-6xl sm:text-7xl md:text-8xl lg:text-[8rem] xl:text-[10rem] font-display leading-[0.85] tracking-tighter uppercase mb-10 glitch-text break-words text-black dark:text-white"
          set:html={titleHasHtml ? title : undefined}
        >
            {!titleHasHtml && titleLines ? (
              titleLines.map((line, i) => {
                const isUmbraco = line.toUpperCase().includes('UMBRACO');
                return (
                  <>
                    {isUmbraco ? (
                      <span class="text-primary">{line}</span>
                    ) : (
                      line
                    )}
                    {i < titleLines.length - 1 && <br/>}
                  </>
                );
              })
            ) : !titleHasHtml ? (
              title
            ) : null}
        </h1>
      </Reveal>

      {caption && (
        <Reveal delay={0.3} width="100%" client:visible>
          <div class="max-w-xl p-6 md:p-8 bg-white dark:bg-black border-4 border-black dark:border-white shadow-brutal-red dark:shadow-brutal-white relative z-30 transition-colors duration-300">
              <p class="text-lg md:text-2xl leading-tight font-bold mb-8 uppercase text-black dark:text-white">
              {caption}
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                {buttons.length > 0 && buttons[0] ? (
                  <a href={buttons[0].url || '#'} class="inline-block">
                    <Button icon={Zap} variant={buttons[0].variant || 'primary'} client:load>{buttons[0].text || 'Button'}</Button>
                  </a>
                ) : (
                  <Button icon={Zap} client:load>Initiate Sequence</Button>
                )}
                {buttons.length > 1 && buttons[1] ? (
                  <a href={buttons[1].url || '#'} class="inline-block">
                    <Button variant={buttons[1].variant || 'outline'} client:load>{buttons[1].text || 'Button'}</Button>
                  </a>
                ) : buttons.length === 0 ? (
                  <Button variant="outline" client:load>View_Members</Button>
                ) : null}
              </div>
          </div>
        </Reveal>
      )}
    </div>

    {/* Right Content / Image Overlay - LCP: no animation wrapper so image is visible on first paint */}
    <div class="lg:col-span-5 xl:col-span-4 z-10 flex flex-col items-center justify-center lg:justify-end mt-10 lg:mt-0 w-full">
      <div class="relative w-full max-w-lg lg:max-w-full aspect-square border-4 border-black dark:border-white grayscale hover:grayscale-0 transition-all duration-500 shadow-brutal-yellow dark:shadow-brutal-white overflow-hidden bg-gray-900 group">
        <img
          src={slideImage}
          alt=""
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-90 group-hover:scale-110 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent opacity-60"></div>
        <div class="absolute top-4 left-4 bg-primary text-black dark:text-white px-2 py-1 text-xs md:text-sm font-bold border-2 border-black dark:border-white">
          {slideLabel}
        </div>
        <div class="absolute bottom-4 right-4 bg-accent-yellow text-black dark:text-white px-2 py-1 text-xs md:text-sm font-bold border-2 border-black dark:border-white">
          {slideLabelTwo}
        </div>
      </div>

      {/* Next Session Box */}
      <Slide direction="right" delay={0.6} width="100%" client:visible>
        <div class="w-full max-w-lg lg:max-w-full mt-6 bg-white dark:bg-black border-4 border-black dark:border-white p-5 shadow-brutal-black dark:shadow-brutal-white transition-colors duration-300 relative group cursor-pointer hover:-translate-y-1 hover:shadow-brutal-yellow">
            <div class="absolute top-0 right-0 bg-primary text-black dark:text-white px-3 py-1 font-bold text-xs border-l-4 border-b-4 border-black dark:border-white">
                NEXT_EVENT
            </div>
            
            <p class="font-mono text-xs font-bold text-gray-500 dark:text-gray-400 mb-2">
                // SESSION_NEW
            </p>
            
            <h2 class="text-2xl md:text-3xl font-display uppercase leading-none mb-4 text-black dark:text-white group-hover:text-primary transition-colors">
                {upcomingSessionTitle}
            </h2>
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-sm font-bold font-mono text-black dark:text-white border-t-2 border-black dark:border-white pt-3">
                <div class="flex gap-4">
                {upcomingSessionDate && (
                <div class="flex items-center gap-2">
                    <Calendar className="w-4 h-4" />
                    <span>{upcomingSessionDate}</span>
                </div>
                )}
                {upcomingSessionTime && (
                <div class="flex items-center gap-2">
                    <Clock className="w-4 h-4" />
                    <span>{upcomingSessionTime}</span>
                </div>
                )}
                </div>
                <ArrowRight className="w-5 h-5 group-hover:translate-x-2 transition-transform" />
            </div>
        </div>
      </Slide>
    </div>
  </div>
</section>

