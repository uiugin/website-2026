---
import { Reveal } from '../react/Reveal';
import type { FeaturesProps } from '../../lib/features-mapper';

interface Props {
  features?: FeaturesProps;
}

const { features } = Astro.props;

// Default features as fallback
const defaultFeatures = [
  {
    number: '01',
    title: 'CODE',
    description: 'Deep dive into the architecture. Push the CMS beyond its limits.',
    variant: 'red' as const
  },
  {
    number: '02',
    title: 'SYNC',
    description: 'Connect with the architects shaping the Indian ecosystem.',
    variant: 'yellow' as const
  },
  {
    number: '03',
    title: 'EVOLVE',
    description: 'Not just a community. An evolutionary jump for your career.',
    variant: 'black' as const
  }
];

// Use features from props if available, otherwise use defaults
const featuresToRender = features?.features && features.features.length > 0 
  ? features.features 
  : defaultFeatures;

const shadows = {
  red: 'shadow-brutal-red dark:shadow-brutal-red hover:bg-primary hover:text-black',
  yellow: 'shadow-brutal-yellow dark:shadow-brutal-yellow hover:bg-accent-yellow hover:text-black',
  black: 'shadow-brutal-black dark:shadow-brutal-white hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black',
};
---

<section class="px-4 md:px-10 mb-20 w-full">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
    {featuresToRender.map((feature, index) => {
      const variant = feature.variant || 'red';
      const shadowClass = shadows[variant];
      const delay = index === 0 ? 0.1 : index === 1 ? 0.3 : 0.5;
      
      return (
        <Reveal delay={delay} width="100%" className="h-full" client:visible>
          <div class={`bg-white dark:bg-black border-4 border-black dark:border-white p-8 md:p-10 transition-colors duration-200 group h-full flex flex-col justify-between text-black dark:text-white ${shadowClass}`}>
            <div>
              <h3 class="text-3xl md:text-4xl font-display mb-6 group-hover:translate-x-2 transition-transform">
                {feature.number}_{feature.title}
              </h3>
            </div>
            <p class="font-bold text-sm md:text-base leading-relaxed uppercase">
              {feature.description}
            </p>
          </div>
        </Reveal>
      );
    })}
  </div>
</section>

