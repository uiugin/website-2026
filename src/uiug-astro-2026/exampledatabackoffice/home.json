                      "properties": {
                        "question": "LEGACY: UMBRACO 7 SUPPORT? test",
                        "answer": {
                          "markup": "<p><span style=\"color: rgb(34, 25, 27); font-family: monospace; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: pre-wrap; background-color: rgb(255, 251, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;\">WARNING: LEGACY SYSTEMS DETECTED. While we respect the history, our focus is on current Long Term Support (LTS) versions and the bleeding edge. Upgrade sequence recommended immediately.test</span></p>",
